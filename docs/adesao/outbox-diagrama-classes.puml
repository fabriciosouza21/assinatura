@startuml
title Outbox — diagrama de classes

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Domínio de assinatura" {
  class Assinatura <<Entity>> {
    - id: Long
    - uuid: String
    - usuarioId: Long
    - plano: Plano
    - status: StatusAssinatura
    - dataInicio: LocalDate
    - dataExpiracao: LocalDate
  }

  class AssinaturaSolicitada <<Domain Event>> {
    + eventId: UUID
    + ocorridoEm: Instant
    + assinaturaId: UUID
    + usuarioId: UUID
    + plano: Plano
    + valor: BigDecimal
  }

  note right of Assinatura
    valor não é persistido na entidade;
    é derivado de Plano.valor() apenas
    ao montar o evento AssinaturaSolicitada.
  end note

  interface AssinaturaRepository {
    + save(assinatura: Assinatura): Assinatura
  }

  class SolicitarAssinatura <<Application Service>> {
    + executar(usuarioUuid: String, plano: Plano): Assinatura
  }
}

package "Outbox" {
  class OutboxEvent <<Entity>> {
    - eventId: UUID
    - aggregateType: String
    - aggregateId: UUID
    - eventType: String
    - payload: JSON
    - status: OutboxStatus
    - tentativas: int
    - proximaTentativaEm: Instant
    - criadoEm: Instant
    - publicadoEm: Instant
    - falhouEm: Instant
    - ultimoErro: String
    + marcarPublicado(publicadoEm: Instant)
    + registrarFalha(erro: String, proximaTentativa: Instant)
    + marcarFalha(erro: String, falhouEm: Instant)
  }

  enum OutboxStatus {
    PENDENTE
    PUBLICADO
    FALHA
  }

  note right of OutboxStatus
    Não implementado / fora de escopo:
    não existe 4º estado DESCARTADO no
    código atual (ver PRD da outbox).
  end note

  interface OutboxRepository {
    + save(evento: OutboxEvent)
    + buscarPublicaveis(agora: Instant, limite: int): List<OutboxEvent>
  }

  class OutboxPublisher <<Scheduled Service>> {
    - kafkaTemplate: KafkaTemplate
    + publicarPendentes()
  }

  class RetryPolicy {
    - maximoTentativas: int = 3
    - backoffInicial: Duration
    - jitter: double
    + calcularProximoAtraso(tentativa: int): Duration
  }
}

note as RecoveryNote
  Não implementado / fora de escopo:
  não existe OutboxRecoveryService nem
  reprocessamento manual no código atual.
  Interface humana de reprocessamento de
  eventos FALHA é Out of Scope no PRD da outbox.
end note

SolicitarAssinatura --> AssinaturaRepository
SolicitarAssinatura --> OutboxRepository
SolicitarAssinatura ..> AssinaturaSolicitada : cria
AssinaturaSolicitada ..> OutboxEvent : serializado como
OutboxEvent --> OutboxStatus

OutboxPublisher --> OutboxRepository
OutboxPublisher --> RetryPolicy

note right of SolicitarAssinatura
  Assinatura e OutboxEvent são
  persistidos na mesma transação.
end note

note bottom of RetryPolicy
  Backoff exponencial com jitter.
  A terceira falha encerra
  o retry automático.
end note

@enduml
