#!/usr/bin/env bash
# Hook pre-commit: roda checkstyle + spotless nos serviços Spring Boot (services/*)
# que tiverem arquivos .java alterados.
# Bypass: SKIP_PRE_COMMIT=1 git commit ...

set -euo pipefail

if [ "${SKIP_PRE_COMMIT:-0}" = "1" ]; then
  echo "[pre-commit] bypassado por SKIP_PRE_COMMIT=1"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Coleta os serviços (subpastas de services/) que têm arquivos .java no stage.
mapfile -t servicos < <(
  git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^services/[^/]+/.+\.java$' \
    | sed -E 's|^services/([^/]+)/.*|\1|' \
    | sort -u
)

if [ "${#servicos[@]}" -eq 0 ]; then
  echo "[pre-commit] nenhum arquivo .java de serviço no stage, pulando lint"
  exit 0
fi

for svc in "${servicos[@]}"; do
  dir="services/${svc}"
  if [ ! -f "${dir}/Makefile" ]; then
    echo "[pre-commit] ${dir} sem Makefile, pulando"
    continue
  fi
  echo "[pre-commit] executando make lint em ${dir} (checkstyle + spotless)"
  if ! make -C "${dir}" lint; then
    cat <<EOF

[pre-commit] FALHOU em ${dir}. Corrija as violacoes acima antes de commitar.

  Dicas:
    - Formatacao:    make -C ${dir} format   (corrige automaticamente)
    - Checkstyle:    ajuste o codigo conforme as regras apontadas
    - Emergencias:   SKIP_PRE_COMMIT=1 git commit ...

EOF
    exit 1
  fi
done

echo "[pre-commit] OK"
