# Copie para .env e ajuste conforme o ambiente.
#
# Este .env é lido pelo docker-compose (serviço assinatura). Para rodar a app
# fora do compose (na JVM local), lembre-se de que o Kafka anuncia-se como
# host "kafka:9092" (nome interno do compose); o ideal é subir tudo via
# "docker compose up".

# Perfil do Spring
SPRING_PROFILES_ACTIVE=dev

# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/assinatura
SPRING_DATASOURCE_USERNAME=assinatura
SPRING_DATASOURCE_PASSWORD=assinatura

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Rotas eventType -> topico (outbox). Defaults em application.yaml.
APP_KAFKA_ROTAS_ASSINATURA_SOLICITADA=assinatura-solicitada
APP_KAFKA_ROTAS_RENOVACAO_SOLICITADA=renovacao-solicitada

# Scheduler de renovacao. Defaults em application.yaml.
APP_RENOVACAO_INTERVALO_MS=60000
APP_RENOVACAO_TAMANHO_LOTE=100

# JWT
APP_JWT_SECRET=ZmIxMjM0NTY3ODkwYWJjZGVmMTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTBhYmNkZWYxMjM0NTY3ODkwYWJjZGVmMTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTA=
APP_JWT_EXPIRATION_MS=3600000

# Mock de pagamento
MOCK_WEBHOOK_SECRET=mock-webhook-secret
