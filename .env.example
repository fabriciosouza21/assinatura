# Copie para .env e ajuste conforme o ambiente.
#
# Este .env é lido pelo docker-compose (serviços assinatura e pagamento). Para
# rodar a app fora do compose (na JVM local), lembre-se de que o Kafka anuncia-se
# como host "kafka:9092" (nome interno do compose); o ideal é subir tudo via
# "docker compose up".

# Perfil do Spring
SPRING_PROFILES_ACTIVE=dev

# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/assinatura
SPRING_DATASOURCE_USERNAME=assinatura
SPRING_DATASOURCE_PASSWORD=assinatura

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Rotas eventType -> topico (outbox). Defaults em application.yaml.
APP_KAFKA_ROTAS_ASSINATURA_SOLICITADA=assinatura-solicitada
APP_KAFKA_ROTAS_RENOVACAO_SOLICITADA=renovacao-solicitada
APP_KAFKA_ROTAS_ASSINATURA_RENOVADA=assinatura-renovada
APP_KAFKA_ROTAS_ASSINATURA_SUSPENSA=assinatura-suspensa
APP_KAFKA_ROTAS_CANCELAMENTO_AGENDADO=cancelamento-agendado
APP_KAFKA_ROTAS_ASSINATURA_CANCELADA=assinatura-cancelada

# Scheduler de renovacao. Defaults em application.yaml.
APP_RENOVACAO_INTERVALO_MS=60000
APP_RENOVACAO_TAMANHO_LOTE=100
# Duracao do ciclo de renovacao, em milissegundos. Default: 30 dias (2592000000).
# Menos de um dia faz a renovacao vencer no proprio dia da ativacao e disparar no
# proximo ciclo do scheduler: ideal para testar o fluxo de renovacao via Bruno.
APP_RENOVACAO_CICLO_MS=2592000000

# Cache da listagem de assinaturas. TTL em segundos; rede de seguranca
# caso alguma invalidacao falhe.
APP_CACHE_ASSINATURA_LISTA_TTL=300

# JWT
APP_JWT_SECRET=ZmIxMjM0NTY3ODkwYWJjZGVmMTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTBhYmNkZWYxMjM0NTY3ODkwYWJjZGVmMTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTA=
APP_JWT_EXPIRATION_MS=3600000

# Mock de pagamento
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# Pagamento Service
APP_RENOVACAO_SCHEDULER_INTERVALO_MS=5000
APP_RENOVACAO_SCHEDULER_DELAY_INICIAL_MS=0
# Uma entrada por espera entre tentativas, em dias. O ciclo tem uma tentativa a mais
# que o tamanho da lista, porque a ultima recusa esgota em vez de reagendar:
# 1,3 rende tres tentativas, em D+0, D+1 e D+3.
APP_RENOVACAO_TENTATIVAS_BACKOFF_DIAS=1,3

# Rotas eventType -> topico (outbox). Defaults em application.yaml.
APP_KAFKA_ROTAS_PAGAMENTO_STATUS_ATUALIZADO=pagamento-status-atualizado
APP_KAFKA_ROTAS_PAGAMENTO_RENOVACAO_APROVADO=renovacao-resultado
APP_KAFKA_ROTAS_RENOVACAO_TENTATIVAS_ESGOTADAS=renovacao-resultado

# Outbox (publisher de eventos de resultado de cobranca). Defaults em application.yaml.
APP_OUTBOX_INTERVALO_MS=5000
APP_OUTBOX_TAMANHO_LOTE=100
APP_OUTBOX_MAX_TENTATIVAS=3
APP_OUTBOX_BACKOFF_INICIAL_SEGUNDOS=1
APP_OUTBOX_JITTER_MILLIS=500

# Perfil de teste rapido da renovacao via Bruno (ver bruno/README.md). Acelera
# schedulers, dispara a renovacao logo apos a ativacao (ciclo < 1 dia) e torna os
# retries de cobranca imediatos, permitindo testar aprovacao e esgotamento em segundos:
#   APP_RENOVACAO_CICLO_MS=60000
#   APP_RENOVACAO_INTERVALO_MS=1000
#   APP_RENOVACAO_SCHEDULER_INTERVALO_MS=1000
#   APP_RENOVACAO_TENTATIVAS_BACKOFF_DIAS=0,0
#   APP_OUTBOX_INTERVALO_MS=1000
